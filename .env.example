# Turn on real Strands orchestration. Leave 0 for UI/demo development.
PORCHLIGHT_USE_STRANDS=0

# Model provider for Strands. For the hackathon demo we can use Gemini while retaining
# Bedrock support. If omitted, Porchlight auto-selects Gemini when GEMINI_API_KEY exists.
PORCHLIGHT_MODEL_PROVIDER=gemini
PORCHLIGHT_MODEL_ID=gemini-3.6-flash
GEMINI_API_KEY=

# Optional Bedrock configuration if/when the AWS account has model access.
# PORCHLIGHT_MODEL_PROVIDER=bedrock
# PORCHLIGHT_MODEL_ID=global.amazon.nova-2-lite-v1:0
AWS_REGION=us-east-1
